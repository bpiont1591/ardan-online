# Skopiuj do .env tylko lokalnie (plik .env NIE trafia do repozytorium). Na Renderze ustawiasz to w panelu.
NODE_ENV=production
PORT=3000
DATA_DIR=./data
# BASE_URL=https://twoja-gra.onrender.com   (na Renderze ustawia się samo)
SESSION_SECRET=wpisz-tu-dlugi-losowy-ciag-znakow
ADMIN_LOGIN=admin
ADMIN_EMAIL=ty@example.com
ADMIN_PASSWORD=
# DATABASE_URL=postgresql://user:haslo@host/baza?sslmode=require   (opcjonalnie – Neon.tech)
# Poczta (reset hasła) – wystarczy JEDNA opcja; kolejność automatyczna: Resend API > Brevo API > SMTP
# BREVO_API_KEY=xkeysib-...          (HTTPS, działa na darmowym Renderze)
# RESEND_API_KEY=re_...              (HTTPS, działa na darmowym Renderze)
# MAIL_TRANSPORT=auto                (opcjonalnie: auto | brevo | resend | smtp)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=2525                     (darmowy Render blokuje 25/465/587)
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=ARDAN <no-reply@twojadomena.pl>

# Skopiuj do .env (lokalnie) albo ustaw w panelu hostingu.
NODE_ENV=production
PORT=3000
# Publiczny adres strony – używany w linkach resetu hasła
BASE_URL=https://ardan.example.pl
# Plik bazy SQLite – na hostingu MUSI leżeć na trwałym dysku/wolumenie
DATABASE_PATH=/data/ardan.db
# Ciasteczka tylko przez HTTPS (domyślnie true w produkcji)
COOKIE_SECURE=true
# Liczba proxy przed aplikacją (Render/Fly = 1)
TRUST_PROXY=1
SESSION_DAYS=30
RESET_TOKEN_MINUTES=30
BCRYPT_COST=12
MAX_CHARACTERS=3
# SMTP do wysyłki e-maili z resetem hasła
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ARDAN <no-reply@ardan.example.pl>"
